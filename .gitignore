# flatpak-builder's cache — 11 GB after a single build
flatpak/.flatpak-builder/

# Updater signing keys — the private key must never be committed.
# Generated by `tauri signer generate`; store it in the GitHub secret
# TAURI_SIGNING_PRIVATE_KEY and keep an offline backup. Losing it means no
# future release can be signed, and clients will reject every update.
.tauri-keys/
